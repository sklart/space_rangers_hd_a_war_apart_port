# Build a native CPU static library only; no substitute game executable/NRO.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES MATRIXGAME_DEVKITPRO)
set(MATRIXGAME_DEVKITPRO "$ENV{DEVKITPRO}" CACHE PATH "devkitPro SDK root")
if(NOT MATRIXGAME_DEVKITPRO)
    set(MATRIXGAME_DEVKITPRO "/opt/devkitpro")
endif()
file(TO_CMAKE_PATH "${MATRIXGAME_DEVKITPRO}" MATRIXGAME_DEVKITPRO)
set(SDK_EXE "")
if(CMAKE_HOST_WIN32)
    set(SDK_EXE ".exe")
endif()
set(CMAKE_CXX_COMPILER "${MATRIXGAME_DEVKITPRO}/devkitA64/bin/aarch64-none-elf-g++${SDK_EXE}")
set(CMAKE_AR "${MATRIXGAME_DEVKITPRO}/devkitA64/bin/aarch64-none-elf-ar${SDK_EXE}")
set(CMAKE_RANLIB "${MATRIXGAME_DEVKITPRO}/devkitA64/bin/aarch64-none-elf-ranlib${SDK_EXE}")
set(CMAKE_CXX_FLAGS_INIT "-march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIE -D__SWITCH__ -ffunction-sections -fdata-sections")
set(CMAKE_FIND_ROOT_PATH "${MATRIXGAME_DEVKITPRO}/devkitA64/aarch64-none-elf")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
